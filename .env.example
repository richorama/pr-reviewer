# Platform Selection (azdo or github)
PLATFORM=github

# Azure DevOps Configuration
AZDO_ORG_URL=https://dev.azure.com/your-organization
AZDO_PAT=your-personal-access-token
AZDO_PROJECT=YourProject

# GitHub Configuration
GITHUB_TOKEN=ghp_your_github_token
GITHUB_OWNER=your-github-username-or-org

# Common Configuration (or pass as CLI arguments)
REPOSITORY=YourRepo
PR_ID=123

# Review Configuration
REVIEW_CONFIG_PATH=./review-config.json

# Optional: GitHub Copilot Settings
# If using custom Copilot CLI path
# COPILOT_CLI_PATH=/path/to/copilot
