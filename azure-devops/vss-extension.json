{
  "manifestVersion": 1,
  "id": "pr-reviewer",
  "name": "AI PR Reviewer",
  "version": "1.0.0",
  "publisher": "YOUR_PUBLISHER_ID",
  "description": "AI-powered pull request review using GitHub Copilot for code quality, security, and best practices",
  "categories": [
    "Azure Pipelines"
  ],
  "tags": [
    "PR",
    "Code Review",
    "AI",
    "Copilot",
    "Quality",
    "Security"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "icons": {
    "default": "icon.png"
  },
  "content": {
    "details": {
      "path": "README.md"
    }
  },
  "links": {
    "repository": {
      "uri": "https://github.com/YOUR_USERNAME/pr-reviewer"
    },
    "issues": {
      "uri": "https://github.com/YOUR_USERNAME/pr-reviewer/issues"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/YOUR_USERNAME/pr-reviewer"
  },
  "files": [
    {
      "path": "task",
      "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "pr-reviewer-task",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "task"
      }
    }
  ]
}
